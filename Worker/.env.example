# Host-installed Ubuntu Worker. All paths belong to this Docker/Worker host.
SCHEDULER_URL=https://scheduler.example.internal
WORKER_SERVICE_CREDENTIAL_FILE=/etc/dml/worker-service.secret
WORKER_SCHEDULER_CA_FILE=/etc/dml/control-ca.pem
WORKER_ID_FILE=/var/lib/dml-worker/worker-id
WORKER_STATE_DIR=/var/lib/dml-worker
WORKER_API_HOST=127.0.0.1
WORKER_API_PORT=8600
WORKER_ASSIGNMENT_LEASE_SECONDS=45
MAX_CONCURRENT_JOBS=2
INTERACTIVE_WORKER_ENABLED=0
INTERACTIVE_REGISTRY_PREFIXES=registry.example.internal/team,docker.io/team
# Non-secret username used only when join_worker.sh must create the protected
# pull credential. The script requests the token/password through a hidden prompt.
INTERACTIVE_REGISTRY_USERNAME=<pull-only-registry-user>
INTERACTIVE_REGISTRY_CREDENTIAL_FILE=/etc/dml/registry-pull.json
INTERACTIVE_ACCESS_IMAGE=registry.example.internal/team/access@sha256:REPLACE_WITH_PUBLISHED_DIGEST
INTERACTIVE_PREFLIGHT_IMAGE=registry.example.internal/team/quota-fixture@sha256:REPLACE_WITH_PUBLISHED_DIGEST
INTERACTIVE_HEADSCALE_CA_FILE=/etc/dml/headscale-ca.pem
# Default: desktop/display VRAM and unrelated GPU processes do not block an
# interactive assignment. Scheduler-owned batch/estimation assignments still
# block it. Set to 1 only for the previous strict, completely-idle GPU policy.
INTERACTIVE_REQUIRE_IDLE_GPU=0
INTERACTIVE_GPU_BASELINE_MB=64
INTERACTIVE_GPU_BUSY_PERCENT=1
INTERACTIVE_PULL_TIMEOUT_SECONDS=1800
# Maximum interactive session lifetime in seconds. After this the Worker
# notifies the user (wall broadcast + TIME_UP failure detail in the UI) and
# kills the workload/sidecar/access containers. 600 = 10 minutes. 0 disables
# the local cap (Scheduler INTERACTIVE_LIFETIME_SECONDS still applies).
INTERACTIVE_MAX_DURATION_SECONDS=600
# Debugging failed interactive runtimes: when unset/0 (default) the worker keeps
# failed workload/sidecar/access containers stopped but present so operators can
# run `docker logs` / `docker inspect` on them. Set to 1 to remove failed
# containers automatically. Successful assignments are always cleaned up.
# Remove kept containers manually, e.g.:
#   docker ps -a --filter label=dml.assignment=<assignment-id>
#   docker rm -f <container-id>
INTERACTIVE_CLEANUP_ON_FAILURE=0
# Opt-in workload egress (plan.md Phase 1). 0 = offline (default): the workload
# keeps network_mode "none" and pip/datasets/curl fail with DNS errors. 1 = a
# runtime whose launch_spec.allow_internet is true (Scheduler flag
# INTERACTIVE_INTERNET_ENABLED=1) launches on the default bridge with host DNS.
# Hard local gate: the Scheduler hint alone never opens egress. Requires Worker
# restart; new runtimes only (existing "none" runtimes keep running offline).
# Verify: docker inspect dml-<assignment>-workload --format '{{.HostConfig.NetworkMode}}'
INTERACTIVE_ALLOW_INTERNET=0
# Operator opt-in for usable interactive development workspaces (plan.md §3/§6).
# 0 = strict (default): workload drops ALL capabilities with no-new-privileges.
# 1 = developer workloads (launch_spec.developer_mode=true) run with Docker's
# default restricted capabilities and passwordless `sudo` inside the workload
# only, so `pip install` / `sudo apt-get install` work. Shared-kernel trust:
# enable only where operator accepts container-root. Requires restart; the
# Scheduler INTERACTIVE_DEVELOPER_MODE_ENABLED=1 must also be set and the
# image must carry the io.dml.developer-profile=v1 label or start fails.
INTERACTIVE_ALLOW_DEVELOPER_MODE=0
# VS Code Remote-SSH (plan.md §4-§6). Default off; independent local gate that
# must agree with Scheduler INTERACTIVE_SSH_ENABLED and the image profile.
# sshd runs inside the exact workload on 127.0.0.1:2222 (no published port).
# SSH runtime lifetime for ssh_ready runtimes (default 4h); browser default
# stays INTERACTIVE_MAX_DURATION_SECONDS=600. Per-mode SSH relay cap.
INTERACTIVE_ALLOW_SSH=0
INTERACTIVE_SSH_MAX_DURATION_SECONDS=14400
INTERACTIVE_SSH_CAPACITY=8
DOCKER_DATA_ROOT=/var/lib/docker
OBJECT_STORE_URL=https://objects.example.internal
