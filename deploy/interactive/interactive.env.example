# Provision /etc/distributed-ml/interactive.env with protected permissions.
# Use a real trusted HTTPS endpoint reachable from bridge containers. Host
# loopback is NOT reachable by pointing host.docker.internal at 127.0.0.1.
HM_HEADSCALE_URL=https://headscale.example.invalid
HM_LOGIN_SERVER=https://headscale.example.invalid
# Optional management-only DNS override for a private host TLS admin listener.
# HM_HEADSCALE_URL=https://headscale.example.invalid:8444
# HM_HEADSCALE_HOST_OVERRIDE=headscale.example.invalid
# HM_HEADSCALE_HOST_IP=<persistent-control-network-gateway-IP>
INTERACTIVE_SECRET_DIR=/etc/distributed-ml/interactive-secrets
GATEWAY_ID=gateway-main
GATEWAY_GENERATION=gateway-v1
HM_SIGNING_KID=primary
GW_ORIGINS=https://scheduler.example.invalid
GW_ALLOW_CLI=0
GATEWAY_PORT=8030
# Push-hook environment (not Compose-only): REQUIRE_INTERACTIVE=1
