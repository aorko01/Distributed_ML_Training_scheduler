GW_MANAGEMENT_URL=http://management:8020
HM_GATEWAY_SECRET_FILE=/secrets/gateway
GW_VERIFICATION_KEYS_FILE=/secrets/public.json
GATEWAY_ID=gateway-main
GATEWAY_GENERATION=gateway-v1
GW_ORIGINS=https://scheduler.example.invalid:8443
# VS Code Remote-SSH CLI admission (plan.md §6). Set 1 only after the SSH gate
# passes; permits explicitly configured CLI clients with absent Origin.
# Tickets, destinations (tailnet TCP 9000 only), and per-user/global limits
# are still enforced. Tune per_user/total limits after measuring VS Code.
GW_ALLOW_CLI=0
GW_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
GW_ENROLLMENT_FILE=/bootstrap/enrollment.json
# Restricted bootstrap helper only:
# HM_BOOTSTRAP_SECRET_FILE=/secrets/bootstrap
