# Read by deployment tooling only; the application does not implicitly load .env.
HM_DATABASE_URL=sqlite:////state/management.sqlite
HM_HEADSCALE_URL=https://headscale.example.invalid
HM_LOGIN_SERVER=https://headscale.example.invalid
HM_HEADSCALE_KEY_FILE=/secrets/headscale
HM_CONTROLLER_SECRET_FILE=/secrets/controller
HM_GATEWAY_SECRET_FILE=/secrets/gateway
HM_BOOTSTRAP_SECRET_FILE=/secrets/bootstrap
HM_ENCRYPTION_KEY_FILE=/secrets/encryption
HM_SIGNING_KEY_FILE=/secrets/signing.pem
HM_VERIFICATION_KEYS_FILE=/secrets/public.json
HM_SIGNING_KID=primary
HM_REQUIRED_POLICY_FILE=/required-policy.json
GATEWAY_ID=gateway-main
GATEWAY_GENERATION=gateway-v1
# VS Code Remote-SSH (plan.md §6). Operator-bounded SSH session maximum in
# seconds (default 14400 = 4h); browser grants keep HM_SESSION_MAX=1800.
# Long SSH sessions still end on Stop/revocation/lease loss.
HM_SSH_SESSION_MAX=14400
# HM_CA_FILE=/secrets/trusted-ca.crt (when using a private CA)
