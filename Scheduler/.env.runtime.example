# Scheduler/control-plane host paths. Keep both admission flags off at upgrade.
WORKER_NEW_WORK_ENABLED=0
INTERACTIVE_RUNTIME_ENABLED=0
WORKER_CREDENTIALS_FILE=/etc/dml/worker-credentials.json
WORKER_ASSIGNMENT_LEASE_SECONDS=45
SCHEDULING_POLICY=three-tier
INTERACTIVE_MANAGEMENT_URL=https://management.example.internal
INTERACTIVE_MANAGEMENT_CA_FILE=/etc/dml/management-ca.pem
INTERACTIVE_CONTROLLER_SECRET_FILE=/etc/dml/controller.secret
INTERACTIVE_GATEWAY_WSS_ORIGIN=wss://gateway.example.net
INTERACTIVE_GATEWAY_ID=gateway-main
INTERACTIVE_STARTUP_SECONDS=1920
# Maximum interactive runtime lifetime in seconds, enforced scheduler-side via
# lifetime_deadline (stops with TIME_UP + time-up notice in the UI).
# 600 = 10 minutes. Mirrors Worker INTERACTIVE_MAX_DURATION_SECONDS=600.
INTERACTIVE_LIFETIME_SECONDS=600
INTERACTIVE_PROFILE_VERSION=gpu-v1
INTERACTIVE_PLATFORM=linux/amd64
INTERACTIVE_CPU=2
INTERACTIVE_RAM_GB=8
INTERACTIVE_PIDS=256
INTERACTIVE_WRITABLE_GB=20
INTERACTIVE_PULL_HEADROOM_GB=40
INTERACTIVE_MIN_VRAM_GB=4
INTERACTIVE_GPU_MODELS=
# User-selectable minimum-resource bounds (>= semantics). Requests outside
# these bounds are rejected with 422 and never create a runtime. GPU model is
# an optional exact label; an omitted model means any model with enough VRAM.
INTERACTIVE_MIN_CPU=0.5
INTERACTIVE_MAX_CPU=64
INTERACTIVE_MIN_RAM_GB=0.5
INTERACTIVE_MAX_RAM_GB=512
INTERACTIVE_MIN_WRITABLE_GB=1
INTERACTIVE_MAX_WRITABLE_GB=2000
INTERACTIVE_MAX_VRAM_GB=192
# Explicit root-image policy; default denies empty/root image User.
INTERACTIVE_ALLOW_ROOT=0
# Opt-in workload egress (plan.md Phase 1). 0 = offline (default, network
# "none": pip/load_dataset/curl fail with DNS errors). 1 = new interactive
# runtimes advertise launch_spec.allow_internet so a Worker that ALSO sets its
# own INTERACTIVE_ALLOW_INTERNET=1 launches the workload on the default bridge.
# The browser can never request it. Change requires Scheduler restart.
INTERACTIVE_INTERNET_ENABLED=0
# Durable workspace editor pipeline (plan.md Phases 2-4). Keep off until the
# snapshot capture + Builder import + submission pipeline are deployed and the
# Phase 5 gates pass. WORKSPACE_TRAINING_SUBMISSION_ENABLED requires
# WORKSPACE_SAVE_ENABLED.
WORKSPACE_EDITOR_ENABLED=1
WORKSPACE_SAVE_ENABLED=0
WORKSPACE_TRAINING_SUBMISSION_ENABLED=0
