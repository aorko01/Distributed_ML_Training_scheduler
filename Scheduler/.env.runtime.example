# Scheduler/control-plane host paths. Keep both admission flags off at upgrade.
WORKER_NEW_WORK_ENABLED=0
INTERACTIVE_RUNTIME_ENABLED=0
WORKER_CREDENTIALS_FILE=/etc/dml/worker-credentials.json
WORKER_ASSIGNMENT_LEASE_SECONDS=45
SCHEDULING_POLICY=three-tier
INTERACTIVE_MANAGEMENT_URL=https://management.example.internal
INTERACTIVE_MANAGEMENT_CA_FILE=/etc/dml/management-ca.pem
INTERACTIVE_CONTROLLER_SECRET_FILE=/etc/dml/controller.secret
INTERACTIVE_GATEWAY_WSS_ORIGIN=wss://gateway.example.net
INTERACTIVE_GATEWAY_ID=gateway-main
INTERACTIVE_STARTUP_SECONDS=1920
# Maximum interactive runtime lifetime in seconds, enforced scheduler-side via
# lifetime_deadline (stops with TIME_UP + time-up notice in the UI).
# 600 = 10 minutes. Mirrors Worker INTERACTIVE_MAX_DURATION_SECONDS=600.
INTERACTIVE_LIFETIME_SECONDS=600
INTERACTIVE_PROFILE_VERSION=gpu-v1
INTERACTIVE_PLATFORM=linux/amd64
INTERACTIVE_CPU=2
INTERACTIVE_RAM_GB=8
INTERACTIVE_PIDS=256
INTERACTIVE_WRITABLE_GB=20
INTERACTIVE_PULL_HEADROOM_GB=40
INTERACTIVE_MIN_VRAM_GB=4
INTERACTIVE_GPU_MODELS=
# Explicit root-image policy; default denies empty/root image User.
INTERACTIVE_ALLOW_ROOT=0
